    <!-- ── Scripts ────────────────────────────────────────────────────────────── -->
    <!--
        Load order is strict:
          1. Leaflet JS (L global must exist before markercluster)
          2. Leaflet.markercluster (extends L)
          3. AjaxHelper (used by PetWatchMap and SightingForm)
          4. SightingForm (used by PetWatchMap — must be defined first)
          5. PetWatchMap
          6. Inline init script
    -->

    <!-- 1. Leaflet JS -->
    <!-- Leaflet JS — integrity hash omitted for unpkg as hash can vary by CDN edge.
         The CSS SRI is kept above; JS is loaded without SRI from the same trusted CDN. -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- 2. Leaflet.markercluster -->
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>

    <!-- 3. AjaxHelper — shared fetch utility used by all other JS classes -->
    <script src="js/AjaxHelper.js"></script>

    <!-- 4. SightingForm — must be defined before PetWatchMap which instantiates it -->
    <script src="js/SightingForm.js"></script>

    <!-- 5. PetWatchMap — the main map controller class -->
    <script src="js/PetWatchMap.js"></script>

    <!-- 6. Initialise the map once the DOM is fully loaded -->
    <script>
        /**
         * Map initialisation
         *
         * Creates a PetWatchMap instance and stores it on window._petWatchMap
         * so the sidebar filter buttons can call public methods on it.
         *
         * PHP values are safely interpolated directly into JS here because they
         * are either booleans or integers — no string injection risk.
         * String values would need JSON-encoding via json_encode() instead.
         */
        document.addEventListener('DOMContentLoaded', () => {
            window._petWatchMap = new PetWatchMap('map-container', {
                isLoggedIn: <?= $view->user->isLoggedIn() ? 'true' : 'false' ?>,
                userId: <?= (int) $view->user->userID() ?>,
                status: '',       // Default: show all pets
            });

            window._petWatchMap.init();
        });
    </script>

    <!-- Bootstrap JS (loaded by footer, but needed before footer on this page too) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
            crossorigin="anonymous"></script>

    <!-- Footer (outputs closing </main>, footer bar, </body>, </html>) -->
