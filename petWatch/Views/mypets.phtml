<script>
/**
 * MyPetsSearch
 * Client-side live search for the My Pets dashboard.
 * Filters, sorts and paginates the pet data already embedded in the page
 * as JSON — no page reloads, no AJAX needed.
 */
(function() {

    const PETS_PER_PAGE = 6;

    let currentPage = 1;
    let filteredPets = [];

    // Elements
    const searchInput   = document.getElementById('mp-search-input');
    const speciesSelect = document.getElementById('mp-filter-species');
    const statusSelect  = document.getElementById('mp-filter-status');
    const sortSelect    = document.getElementById('mp-filter-sort');
    const liveResults   = document.getElementById('mp-live-results');
    const livePagination= document.getElementById('mp-live-pagination');
    const liveStatus    = document.getElementById('mp-live-status');
    const phpResults    = document.getElementById('mp-php-results');
    const phpPagination = document.getElementById('mp-php-pagination');
    const phpStatus     = document.getElementById('mp-php-status');

    // Bail if elements not found (safety check)
    if (!searchInput || !liveResults) return;

    // Swap PHP sections for live sections
    phpResults.classList.add('d-none');
    phpPagination.classList.add('d-none');
    phpStatus.classList.add('d-none');
    liveResults.classList.remove('d-none');
    livePagination.classList.remove('d-none');
    liveStatus.classList.remove('d-none');

    // Restore filter state from URL so dropdowns match after a hard navigation
    const params = new URLSearchParams(window.location.search);
    if (params.get('species') && speciesSelect) speciesSelect.value = params.get('species');
    if (params.get('status') && statusSelect) statusSelect.value = params.get('status');
    if (params.get('sort')   && sortSelect)   sortSelect.value   = params.get('sort');
    if (params.get('search') && searchInput)  searchInput.value  = params.get('search');

    // Run initial render
    run();

    // Debounced input listener for the search box
    let debounceTimer;
    searchInput.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => { currentPage = 1; run(); }, 250);
    });

    // Immediate re-render on dropdown change
    if (speciesSelect) speciesSelect.addEventListener('change', () => { currentPage = 1; run(); });
    if (statusSelect) statusSelect.addEventListener('change', () => { currentPage = 1; run(); });
    if (sortSelect)   sortSelect.addEventListener('change',   () => { currentPage = 1; run(); });

    function run() {
        const term    = (searchInput.value || '').toLowerCase().trim();
        const species = speciesSelect ? speciesSelect.value : '';
        const status  = statusSelect  ? statusSelect.value  : '';
        const sort    = sortSelect    ? sortSelect.value    : 'date_newest';

        // Filter
        filteredPets = (window._mpAllPets || []).filter(function(p) {
            // Split into words — every word must match at least one field
            const words = term.split(/\s+/).filter(Boolean);
            const matchTerm = !term || words.every(word =>
                p.name.toLowerCase().includes(word)        ||
                p.species.toLowerCase().includes(word)     ||
                p.breed.toLowerCase().includes(word)       ||
                p.color.toLowerCase().includes(word)       ||
                p.description.toLowerCase().includes(word) ||
                p.status.toLowerCase().includes(word)
            );
            const matchSpecies = !species || p.species.toLowerCase() === species.toLowerCase();
            const matchStatus  = !status  || p.status.toLowerCase() === status.toLowerCase();
            return matchTerm && matchSpecies && matchStatus;
        });

        // Sort
        filteredPets.sort(function(a, b) {
            switch (sort) {
                case 'name_asc':    return a.name.localeCompare(b.name);
                case 'name_desc':   return b.name.localeCompare(a.name);
                case 'date_oldest': return a.date.localeCompare(b.date);
                case 'date_newest':
                default:            return b.date.localeCompare(a.date);
            }
        });

        renderPage();
        renderStatus(term, species, status);
        renderPagination();
    }

    function renderPage() {
        const total  = filteredPets.length;
        const pages  = Math.max(1, Math.ceil(total / PETS_PER_PAGE));
        if (currentPage > pages) currentPage = pages;

        const offset = (currentPage - 1) * PETS_PER_PAGE;
        const page   = filteredPets.slice(offset, offset + PETS_PER_PAGE);

        // Clear and rebuild the results grid
        liveResults.innerHTML = '';

        if (page.length === 0) {
            liveResults.innerHTML = `
                <div class="col-12">
                    <div class="alert alert-warning text-center rounded-4 shadow-lg">
                        <h4>No Pets Found</h4>
                        <p>No pets match your search or filter criteria.
                           <a href="mypets.php" class="alert-link">Clear filters</a> to see all your pets.</p>
                    </div>
                </div>`;
            return;
        }

        const fragment = document.createDocumentFragment();
        page.forEach(function(pet) {
            const col = document.createElement('div');
            col.className = 'col-md-6 col-lg-4 mb-4';
            col.innerHTML = buildCard(pet);
            fragment.appendChild(col);
        });
        liveResults.appendChild(fragment);
    }

    function buildCard(pet) {
        const statusBadge = pet.status === 'found'
            ? '<span class="badge rounded-pill bg-success">Found</span>'
            : '<span class="badge rounded-pill bg-danger">Lost</span>';

        const desc = pet.description
            ? `<p class="mb-2"><strong>Description:</strong> ${pet.description.substring(0, 100)}${pet.description.length > 100 ? '...' : ''}</p>`
            : '';

        return `
            <div class="card card-hover h-100 shadow-lg rounded-5">

                <!-- Pet Photo -->
                <img src="${pet.photo_path}"
                     class="card-img-top"
                     alt="${pet.name}"
                     style="height:250px;object-fit:cover;border-top-left-radius:30px;border-top-right-radius:30px;cursor:pointer;"
                     onclick="window.location.href='map.php?focus=${pet.id}'"
                     title="View on Live Map">

                <!-- Card Header -->
                <div class="card-header bg-light shadow"
                     style="cursor:pointer;"
                     onclick="window.location.href='map.php?focus=${pet.id}'"
                     title="View on Live Map">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-white"><strong>${pet.name}</strong></h5>
                        ${statusBadge}
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body paw-bg">
                    <p class="mb-2"><strong>Species:</strong> ${pet.species}</p>
                    ${pet.breed  ? `<p class="mb-2"><strong>Breed:</strong> ${pet.breed}</p>`  : ''}
                    ${pet.color  ? `<p class="mb-2"><strong>Color:</strong> ${pet.color}</p>`  : ''}
                    ${desc}
                    <p class="mb-2 text-muted"><strong>Date Reported:</strong> ${pet.date}</p>

                    <!-- Update Status Form -->
                    <hr>
                    <p><strong>Update Pet Status</strong></p>
                    <form method="POST" action="mypets.php" class="mb-0">
                        <input type="hidden" name="pet_id" value="${pet.id}">
                        <div class="row g-2">
                            <div class="col-8">
                                <select name="new_status" class="form-select form-select-sm rounded-3 shadow-sm pop-obj">
                                    <option value="lost"  ${pet.status === 'lost'  ? 'selected' : ''}>❌ Lost</option>
                                    <option value="found" ${pet.status === 'found' ? 'selected' : ''}>✅ Found</option>
                                </select>
                            </div>
                            <div class="col-4">
                                <button type="submit" name="updateStatusBtn" class="btn btn-sm btn-primary w-100 rounded-3 shadow-sm pop-obj">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                                    </svg>Update
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-light shadow-lg" style="border-bottom-left-radius:30px;border-bottom-right-radius:30px;">
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted"><strong>Pet ID:</strong> ${pet.id}</small>
                        <a href="mypets.php?action=delete&id=${pet.id}"
                           class="btn btn-outline-danger shadow-sm pop-obj"
                           style="border-bottom-right-radius:25px;"
                           onclick="return confirm('Are you sure you want to delete ${pet.name}? This action cannot be undone.')">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                            </svg>
                            Delete
                        </a>
                    </div>
                </div>

            </div>`;
    }

    function renderStatus(term, species, status) {
        const total = filteredPets.length;
        if (total === 0 && (term || species || status)) {
            liveStatus.innerHTML = 'No owned pets found matching your search.';
            return;
        }
        const from  = total === 0 ? 0 : (currentPage - 1) * PETS_PER_PAGE + 1;
        const to    = Math.min(currentPage * PETS_PER_PAGE, total);
        const filterNote = (term || species || status) ? ' (Filter on)' : '';
        liveStatus.innerHTML = `Showing <strong>${from}–${to}</strong> of <strong>${total}</strong> pet${total !== 1 ? 's' : ''}${filterNote}`;
    }

    function renderPagination() {
        const total = filteredPets.length;
        const pages = Math.max(1, Math.ceil(total / PETS_PER_PAGE));

        if (pages <= 1) { livePagination.innerHTML = ''; return; }

        let html = '<div class="row mt-4 mb-5"><div class="col-12"><nav><ul class="pagination justify-content-center">';

        // Previous
        html += `<li class="page-item ${currentPage <= 1 ? 'disabled' : ''}">
                    <button class="page-link rounded-5 me-1 shadow card-hover"
                            ${currentPage > 1 ? `onclick="goToPage(${currentPage - 1})"` : ''}>Previous</button>
                 </li>`;

        // Page numbers
        for (let i = 1; i <= pages; i++) {
            if (i === 1 || i === pages || Math.abs(i - currentPage) <= 2) {
                html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                             <button class="page-link rounded-5 mx-1 shadow card-hover"
                                     onclick="goToPage(${i})">${i}</button>
                         </li>`;
            } else if (Math.abs(i - currentPage) === 3) {
                html += '<li class="page-item disabled"><span class="page-link rounded-5 mx-1">…</span></li>';
            }
        }

        // Next
        html += `<li class="page-item ${currentPage >= pages ? 'disabled' : ''}">
                    <button class="page-link rounded-5 ms-1 shadow card-hover"
                            ${currentPage < pages ? `onclick="goToPage(${currentPage + 1})"` : ''}>Next</button>
                 </li>`;

        html += '</ul></nav></div></div>';
        livePagination.innerHTML = html;
    }

    // Exposed globally for pagination button onclick handlers
    window.goToPage = function(page) {
        currentPage = page;
        renderPage();
        renderStatus(
            (searchInput.value || '').toLowerCase().trim(),
            speciesSelect ? speciesSelect.value : '',
            statusSelect  ? statusSelect.value  : ''
        );
        renderPagination();
        liveResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

})();
</script>
<?php require('template/footer.phtml'); ?>
