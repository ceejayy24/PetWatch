    <script>
        /* Filter the pet dropdown as the user types in the search box */
        document.getElementById('petSearch').addEventListener('input', function () {
            const term = this.value.toLowerCase();
            const select = document.getElementById('pet_id');
            const options = select.querySelectorAll('option');

            options.forEach(opt => {
                // Always keep the placeholder option visible
                if (!opt.value) { opt.style.display = ''; return; }
                opt.style.display = opt.text.toLowerCase().includes(term) ? '' : 'none';
            });

            // Reset selection if the currently selected option is now hidden
            const selected = select.options[select.selectedIndex];
            if (selected && selected.style.display === 'none') {
                select.selectedIndex = 0;
            }
        });
    </script>


    <script>
        /* Fill lat/lng inputs with the user's current GPS location */
        document.getElementById('use-current-location').addEventListener('click', function (e) {
            e.preventDefault();

            if (!navigator.geolocation) {
                document.getElementById('geoloc-inline-error').style.display = 'block';
                return;
            }

            this.textContent = 'Getting location…';
            const link = this;

            navigator.geolocation.getCurrentPosition(
                function (pos) {
                    document.getElementById('latitude').value = pos.coords.latitude.toFixed(6);
                    document.getElementById('longitude').value = pos.coords.longitude.toFixed(6);
                    link.textContent = 'Current Location';
                },
                function () {
                    document.getElementById('geoloc-inline-error').style.display = 'block';
                    link.textContent = 'Current Location';
                },
                { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
            );
        });
    </script>

