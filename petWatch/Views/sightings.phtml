    <script src="js/AjaxHelper.js"></script>
    <script src="js/LiveSearch.js"></script>

    <script>
        /**
         * LiveSearch initialisation
         *
         * Swaps the page from PHP-rendered results to live AJAX results,
         * then creates and starts the LiveSearch instance.
         *
         * Graceful degradation: if this block fails (JS disabled, script
         * blocked etc.) the PHP form and results remain fully functional.
         */
        document.addEventListener('DOMContentLoaded', () => {

            // Hide PHP-rendered sections, show live search targets
            document.getElementById('php-search-results').classList.add('d-none');
            document.getElementById('php-pagination').classList.add('d-none');
            document.getElementById('php-search-status').classList.add('d-none');
            document.getElementById('search-submit-col').classList.add('d-none'); // hide whole col so dropdowns fill the space

            document.getElementById('live-search-results').classList.remove('d-none');
            document.getElementById('live-search-status').classList.remove('d-none');

            // Create LiveSearch and expose it on window so pagination
            // onclick handlers (window._liveSearch.goToPage(n)) can reach it
            window._liveSearch = new LiveSearch({
                inputId: 'searchTerm',
                resultsId: 'live-search-results',
                statusId: 'live-search-status',
                speciesSelectId: 'searchSpecies',
                statusSelectId: 'searchLostOrFound',
                sortSelectId: 'searchOrder',
                paginationId: 'live-pagination',
            });

            window._liveSearch.init();

            // Prevent the PHP form from doing a page reload for JS users
            // (results are already showing live — a form submit would reset everything)
            const form = document.getElementById('search-form');
            if (form) {
                form.addEventListener('submit', (e) => e.preventDefault());
            }
        });
    </script>

