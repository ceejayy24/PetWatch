     */
    require_once(__DIR__ . '/../../Models/CsrfToken.php');
    ?>
    <meta name="csrf-token" content="<?php echo htmlspecialchars(CsrfToken::getToken(), ENT_QUOTES, 'UTF-8'); ?>">
