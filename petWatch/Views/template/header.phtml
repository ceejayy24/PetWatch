// JS-safe redirect (replaces header() calls)
// Controllers set $view->redirect to a URL string when a redirect is needed.
// We output a <script> here instead of PHP header(), which works after output
// has begun and avoids the "headers already sent" problem.
if (!empty($view->redirect)):
    ?>
    <script>
        // Perform client-side redirect — used instead of PHP header() per brief
        window.location.href = '<?php echo htmlspecialchars($view->redirect, ENT_QUOTES); ?>';
    </script>
<?php endif; ?>

